# ── Obligatoria ──────────────────────────────────────────────
# Clave de fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=

# ── Muy recomendada ──────────────────────────────────────────
# Código de acceso. Si lo defines, la app lo pedirá al entrar.
# Evita que cualquiera que encuentre tu URL gaste tu saldo.
ACCESS_CODE=

# ── Opcionales ───────────────────────────────────────────────
PORT=3000
# Carpeta donde se guardan imágenes e historial (usa un disco persistente en producción)
DATA_DIR=./data
# Tope global de imágenes por día (protege tu gasto)
DAILY_LIMIT=150
# Máximo de generaciones por IP cada 10 minutos
RATE_LIMIT_PER_10_MIN=20
# Pon 1 si despliegas detrás de un proxy (Render, Railway, Fly, Nginx...)
TRUST_PROXY=0
# Modelos de fal.ai (puedes cambiarlos sin tocar el código)
FAST_MODEL=fal-ai/flux/schnell
PRO_MODEL=fal-ai/flux-pro/v1.1
